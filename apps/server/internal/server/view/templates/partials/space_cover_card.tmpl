{{ define "space_cover_card" }}
<a class="space-card" data-space-id="{{ .SpaceID }}" href="/r/{{ .SpaceID }}" aria-label="进入空间 {{ .Name }}">
  {{ if .CoverURL }}
    <img class="space-cover-image" src="{{ .CoverURL }}" alt="{{ .Name }} 封面" loading="lazy" />
  {{ else }}
    <img class="space-cover-image" src="/space-covers/{{ .SpaceID }}" alt="{{ .Name }} 封面" loading="lazy" />
  {{ end }}
</a>
{{ end }}
