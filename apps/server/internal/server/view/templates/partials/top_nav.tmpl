{{ define "top_nav" }}
<header class="top-nav">
  <div class="top-nav-inner">
    <a href="/" class="top-nav-logo" aria-label="{{ if .SiteName }}{{ .SiteName }}{{ else }}bugodoc{{ end }} 首页">
      <img src="/assets/favicon.png?v=bugo" alt="bugodoc" class="top-nav-logo-image" loading="eager" decoding="async">
    </a>

    <div class="top-nav-actions">
      {{ if .IsAuthenticated }}
        <details class="nav-user-dropdown" data-nav-user-dropdown="1">
          <summary class="nav-user-trigger">
            <span class="nav-user-avatar">
              {{ if .CurrentUserAvatarURL }}
                <img src="{{ .CurrentUserAvatarURL }}" alt="{{ .CurrentUserName }} 头像" class="nav-user-avatar-image">
              {{ else }}
                {{ .CurrentUserAvatar }}
              {{ end }}
            </span>
            <span class="nav-user-name">{{ .CurrentUserName }}</span>
            <span class="nav-user-arrow">▾</span>
          </summary>
          <div class="nav-user-menu">
            <a href="{{ .WorkspaceURL }}?create=1" class="nav-user-menu-item">新建空间</a>
            {{ if .CanAccessAdmin }}<a href="{{ .AdminURL }}" class="nav-user-menu-item">后台管理</a>{{ end }}
            <form method="post" action="{{ .LogoutURL }}">
              <button type="submit" class="nav-user-menu-item nav-user-menu-button">退出登录</button>
            </form>
          </div>
        </details>
      {{ else }}
        <div class="top-nav-guest-actions">
          <a href="{{ .LoginURL }}" class="top-nav-login-button">登录</a>
          <a href="{{ .RegisterURL }}" class="top-nav-register-button">注册</a>
        </div>
      {{ end }}
    </div>
  </div>
</header>
{{ end }}
