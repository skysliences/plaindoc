{{ define "youtube_space_card" }}
<article class="yt-card">
  <div class="yt-card-cover">
    <a
      class="yt-card-thumb"
      data-space-id="{{ .SpaceID }}"
      href="/r/{{ .SpaceID }}"
      aria-label="进入空间 {{ .Name }}"
    >
      {{ if .CoverURL }}
        <img class="yt-card-image" src="{{ .CoverURL }}" alt="{{ .Name }} 封面" loading="lazy">
        <span class="yt-card-duration" aria-hidden="true">文档空间</span>
      {{ else }}
        <img class="yt-card-image" src="/space-covers/{{ .SpaceID }}" alt="{{ .Name }} 封面" loading="lazy">
      {{ end }}
    </a>
    {{ if .ManageURL }}
      <button type="button" class="yt-card-manage" data-space-manage-url="{{ .ManageURL }}"
        aria-label="管理空间 {{ .Name }}" aria-haspopup="dialog" aria-controls="space-management-dialog">
        <span aria-hidden="true">•••</span>
      </button>
    {{ end }}
  </div>

  <div class="yt-card-content">
    <span class="yt-card-avatar" aria-hidden="true">
      {{ if .OwnerAvatar }}
        <img src="{{ .OwnerAvatar }}" alt="" class="yt-card-avatar-image" loading="lazy" decoding="async">
      {{ else }}
        <span class="yt-card-avatar-fallback">{{ avatarInitial .OwnerName }}</span>
      {{ end }}
    </span>
    <div class="yt-card-meta">
      <a
        class="yt-card-title-link"
        href="/r/{{ .SpaceID }}"
        aria-label="打开空间 {{ .Name }}"
      >
        <h2 class="yt-card-title">{{ .Name }}</h2>
      </a>
      <p class="yt-card-channel">{{ .OwnerName }} · 最后更新：{{ formatFriendlyRelativeTime .UpdatedAt }}</p>
      {{ if .Description }}
        <p class="yt-card-desc">{{ .Description }}</p>
      {{ else }}
        <p class="yt-card-desc">点击进入查看该空间的在线文档内容。</p>
      {{ end }}
    </div>
  </div>
</article>
{{ end }}

{{ define "space_management_dialog" }}
{{ if .IsAuthenticated }}
<dialog id="space-management-dialog" class="yt-space-dialog yt-space-management-dialog" aria-labelledby="space-management-title">
  <header>
    <h2 id="space-management-title">管理空间</h2>
    <form method="dialog"><button type="submit" aria-label="关闭" autofocus><span aria-hidden="true">×</span></button></form>
  </header>
  <iframe name="plaindoc-space-management" title="空间管理"></iframe>
</dialog>
{{ end }}
{{ end }}
