{{ define "youtube_top_nav" }}
<header class="yt-header">
  <div class="yt-header-inner">
    <div class="yt-header-left">
      <button
        type="button"
        class="yt-nav-toggle"
        data-yt-nav-toggle
        aria-controls="yt-sidebar"
        aria-expanded="false"
        aria-label="打开分类导航"
      >
        <span class="yt-nav-toggle-bar" aria-hidden="true"></span>
        <span class="yt-nav-toggle-bar" aria-hidden="true"></span>
        <span class="yt-nav-toggle-bar" aria-hidden="true"></span>
      </button>
      <a href="/" class="yt-brand" aria-label="{{ .SiteName }} 首页">
        <img src="/assets/favicon.png?v=bugo" alt="BUGO" class="yt-brand-logo" loading="eager" decoding="async">
        <span class="yt-brand-badge">Docs</span>
      </a>
    </div>

    {{ if .SearchEnabled }}
      <div id="yt-search-panel" class="yt-header-center" data-yt-search-panel>
        <div class="yt-header-search-wrap">
          <form class="yt-header-search-form" action="{{ .SearchActionURL }}" method="get" role="search">
            <input
              class="yt-header-search-input"
              type="search"
              name="q"
              value="{{ .SearchKeyword }}"
              placeholder="检索文档标题或正文"
              aria-label="全文检索关键词"
              autocomplete="off"
            >
            <button class="yt-header-search-button" type="submit">搜索</button>
          </form>
        </div>
      </div>
    {{ end }}

    <div class="yt-header-right">
      {{ if .SearchEnabled }}
        <button
          type="button"
          class="yt-search-toggle"
          data-yt-search-toggle
          aria-controls="yt-search-panel"
          aria-expanded="false"
          aria-label="打开搜索"
        >
          <svg
            class="yt-search-toggle-icon"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"></circle>
            <path d="M16 16L20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
          </svg>
        </button>
      {{ end }}

      {{ if .IsAuthenticated }}
        <button
          type="button"
          class="yt-create-button"
          aria-label="新建空间"
          aria-haspopup="dialog"
          aria-controls="create-space-dialog"
          data-create-space-trigger
        >
          <span class="yt-create-button-icon" aria-hidden="true">+</span>
          <span>新建空间</span>
        </button>
      {{ end }}

      {{ if .IsAuthenticated }}
        <details class="yt-user-dropdown" data-nav-user-dropdown="1">
          <summary class="yt-user-trigger">
            <span class="yt-user-avatar">
              {{ if .CurrentUserAvatarURL }}
                <img src="{{ .CurrentUserAvatarURL }}" alt="{{ .CurrentUserName }} 头像" class="yt-user-avatar-image">
              {{ else }}
                {{ .CurrentUserAvatar }}
              {{ end }}
            </span>
          </summary>
          <div class="yt-user-menu">
            <p class="yt-user-menu-name">{{ .CurrentUserName }}</p>
            {{ if .CanAccessAdmin }}<a href="{{ .AdminURL }}" class="yt-user-menu-item">后台管理</a>{{ end }}
            <form method="post" action="{{ .LogoutURL }}">
              <button type="submit" class="yt-user-menu-item yt-user-menu-button">退出登录</button>
            </form>
          </div>
        </details>
      {{ else }}
        <div class="yt-guest-actions">
          <a href="{{ .LoginURL }}" class="yt-signin-button">登录</a>
          <a href="{{ .RegisterURL }}" class="yt-register-button">注册</a>
        </div>
      {{ end }}
    </div>
  </div>
</header>
{{ end }}
{{ define "create_space_dialog" }}
{{ if .IsAuthenticated }}
<dialog id="create-space-dialog" class="yt-space-dialog" data-create-space-dialog{{ if .SpaceCreationError }} data-reopen{{ end }} aria-labelledby="create-space-title">
  <form method="post" action="/spaces">
    <h2 id="create-space-title">新建空间</h2>
    <p class="yt-space-dialog-description">创建后，你可以从示例文档开始编辑。</p>
    <label for="create-space-name">空间名称</label>
    <input id="create-space-name" name="name" required autofocus>
    {{ if .SpaceCreationError }}<p role="alert" class="yt-space-dialog-error">{{ .SpaceCreationError }}</p>{{ end }}
    <div class="yt-space-dialog-actions">
      <button type="button" class="yt-space-dialog-cancel" data-create-space-cancel>取消</button>
      <button type="submit" class="yt-space-dialog-submit">创建空间</button>
    </div>
  </form>
</dialog>
{{ end }}
{{ end }}
